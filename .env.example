# Copy to .env and edit locally. The server reads environment variables, not this file.
ADDR=127.0.0.1:8081
DB_PATH=data/west.db
WEB_ROOT=frontend/dist

# Keep false until merchant credentials, account bindings and domains are ready.
WECHATPAY_ENABLED=false
PUBLIC_BASE_URL=https://pay.example.com
WECHATPAY_APP_ID=replace_with_official_account_appid
WECHATPAY_MCH_ID=replace_with_merchant_id
WECHATPAY_MERCHANT_SERIAL=replace_with_merchant_certificate_serial
WECHATPAY_PRIVATE_KEY_PATH=secrets/apiclient_key.pem
WECHATPAY_API_V3_KEY_FILE=secrets/api_v3_key.txt
WECHATPAY_APP_SECRET_FILE=secrets/app_secret.txt

# WeChat Pay public key and public key ID, downloaded from merchant platform.
WECHATPAY_PUBLIC_KEY_ID=replace_with_wechatpay_public_key_id
WECHATPAY_PUBLIC_KEY_PATH=secrets/wechatpay_public_key.pem

# Alternative for a merchant using a platform certificate:
# Remove the two PUBLIC_KEY variables above, then set the certificate path.
# WECHATPAY_PLATFORM_CERT_PATH=secrets/wechatpay_platform_cert.pem
